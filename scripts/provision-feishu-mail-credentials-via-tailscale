#!/bin/zsh
set -euo pipefail

target="${FEISHU_MAIL_VPS_TARGET:-ubuntu@bobvps}"
remote_env_path="${FEISHU_MAIL_ENV_PATH:-/home/hermes/.hermes/feishu-mail.env}"

fail() {
  print -u2 -- "$1"
  exit 1
}

if [[ "$target" != *'@'* || "$target" == *$'\n'* || "$target" == *$'\r'* ]]; then
  fail 'FEISHU_MAIL_VPS_TARGET must be a single-line Tailscale SSH target in the form user@MagicDNS-host'
fi

target_user="${target%%@*}"
target_host="${target#*@}"
if [[ -z "$target_user" || -z "$target_host" || "$target_user" == *[^A-Za-z0-9._-]* || "$target_host" == *[^A-Za-z0-9.-]* || "$target_host" == <->.<->.<->.<-> || "$target_host" == *:* ]]; then
  fail 'FEISHU_MAIL_VPS_TARGET must be a single-line Tailscale SSH target in the form user@MagicDNS-host'
fi

command -v tailscale >/dev/null || fail 'Tailscale CLI is unavailable locally. Start or install Tailscale before provisioning Feishu mail retrieval.'
command -v security >/dev/null || fail 'macOS Keychain is unavailable. Run this helper from Craig’s Mac.'

app_id="$(security find-generic-password -s codex-feishu-app-id -w)"
app_secret="$(security find-generic-password -s codex-feishu-app-secret -w)"
[[ -n "$app_id" && -n "$app_secret" ]] || fail 'Feishu credentials are missing from macOS Keychain. Run scripts/store-feishu-credentials first.'
[[ "$app_id" != *$'\n'* && "$app_secret" != *$'\n'* && "$app_id" != *$'\r'* && "$app_secret" != *$'\r'* ]] || fail 'Feishu credentials in macOS Keychain are invalid.'

printf 'FEISHU_APP_ID=%s\nFEISHU_APP_SECRET=%s\n' "$app_id" "$app_secret" |
  tailscale ssh "$target" sudo -n -u hermes tee "$remote_env_path" >/dev/null
tailscale ssh "$target" sudo -n -u hermes chmod 600 "$remote_env_path"

print 'Feishu mail credentials were provisioned to the Hermes VPS over Tailscale.'
