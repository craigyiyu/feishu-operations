#!/bin/zsh
set -euo pipefail

read -r "app_id?Feishu App ID: "
read -rs "app_secret?Feishu App Secret: "
print

if [[ -z "$app_id" || -z "$app_secret" ]]; then
  print -u2 "Both App ID and App Secret are required."
  exit 1
fi

security add-generic-password -U -s codex-feishu-app-id -a "$USER" -w "$app_id" >/dev/null
security add-generic-password -U -s codex-feishu-app-secret -a "$USER" -w "$app_secret" >/dev/null
print "Feishu credentials saved to macOS Keychain."
